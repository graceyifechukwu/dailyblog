<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('partials/header', { title: pageTitle }) %>

    <main class="page-shell narrow-shell">
      <section class="card form-card">
        <div class="section-heading">
          <h1>Edit Post</h1>
          <p>Update the title and content, then save your changes.</p>
        </div>

        <form class="post-form" action="/posts/<%= post.id %>/update" method="POST">
          <label>
            <span>Title</span>
            <input type="text" name="title" value="<%= post.title %>" required />
          </label>

          <label>
            <span>Content</span>
            <textarea name="content" rows="8" required><%= post.content %></textarea>
          </label>

          <div class="button-row">
            <a class="button button-secondary" href="/">Cancel</a>
            <button type="submit" class="button button-primary">Save Changes</button>
          </div>
        </form>
      </section>
    </main>
  </body>
</html>